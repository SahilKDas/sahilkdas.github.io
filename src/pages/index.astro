---
import { Image } from 'astro:assets'
import 'lenis/dist/lenis.css'
import repos from '../data/repos.json'
import portalSky from '../assets/cinema/portal/sky.png'
import portalLandscape from '../assets/cinema/portal/landscape.png'
import portalArchitecture from '../assets/cinema/portal/architecture.png'
import portalForeground from '../assets/cinema/portal/foreground.png'
import fieldSky from '../assets/cinema/field/sky.png'
import fieldMist from '../assets/cinema/field/mist.png'
import fieldFlora from '../assets/cinema/field/flora.png'
import fieldGrass from '../assets/cinema/field/grass.png'
import abyssDeepfield from '../assets/cinema/abyss/deepfield.png'
import abyssDisc from '../assets/cinema/abyss/disc.png'
import '../styles/global.css'

const categories = ['All', 'Systems', 'Engines', 'Languages', 'Games', 'Tools', 'Web', 'Experiments']
const counts = Object.fromEntries(categories.map(category => [category, category === 'All' ? repos.length : repos.filter(repo => repo.category === category).length]))
const featuredNames = ['LFE-NNUE', 'Battle-Bound-DX', 'KinokoDS', 'Eloi']
const featured = featuredNames.map(name => repos.find(repo => repo.name === name)).filter(Boolean)
const horizonNames = ['Genseki', '64DS-DX', 'MK7-Native', 'Sekigahara']
const horizons = horizonNames.map(name => repos.find(repo => repo.name === name)).filter(Boolean)
const interests = ['Neural search', 'Reinforcement learning', 'Native reconstruction', 'Board-game engines', 'Vulkan graphics', 'Emulation', 'Language runtimes', 'Open protocols']
const clean = (value: string) => value.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/[`*_]/g, '')
const date = (value: string) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(value))
const activitySeed = [
  ['push', 'SahilKDas/LFE-NNUE', 'main'],
  ['push', 'SahilKDas/Battle-Bound-DX', 'main'],
  ['push', 'SahilKDas/KinokoDS', 'main'],
  ['release', 'SahilKDas/Eloi', 'v4.0.1'],
  ['push', 'OpenShobu/Sekigahara', 'main'],
  ['push', 'OpenShobu/cani', 'main'],
] as const
const fallbackActivity = activitySeed.map(([kind, fullName, detail]) => ({ kind, repo: fullName, detail, timestamp: repos.find(repo => repo.fullName === fullName)?.updatedAt ?? '2026-11-08T00:00:00Z', href: `https://github.com/${fullName}` }))
const imageWidths = [960, 1600, 2400]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#02060b" />
    <meta name="description" content="I’m Sahil K. Das. I build neural engines, native runtimes, game systems, languages, and open infrastructure." />
    <meta property="og:title" content="Sahil K. Das — Systems Between Worlds" />
    <meta property="og:description" content="A living systems atlas: engines, neural work, native reconstruction, organizations, and experiments." />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2302060b'/%3E%3Cpath d='M14 42V22h17v6H21v3h9v6h-9v5h-7Zm20 0V22h7v8l7-8h8L45 32l12 10h-9l-7-7v7h-7Z' fill='%237bd9ff'/%3E%3C/svg%3E" />
    <title>Sahil K. Das — Systems Between Worlds</title>
  </head>
  <body>
    <a class="skip-link" href="#atlas">Skip the cinematic introduction</a>
    <div class="film-grain" aria-hidden="true"></div>
    <div class="pointer-aura" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"><i data-progress></i></div>
    <div class="cinema-chrome" aria-hidden="true"><div class="letterbox letterbox-top"></div><div class="letterbox letterbox-bottom"></div><p class="scene-slate" data-scene-slate></p></div>

    <header class="topbar" data-topbar>
      <a class="wordmark link-line" href="#top" aria-label="Sahil K. Das, home">Sahil K. Das</a>
      <nav aria-label="Sections"><a class="link-line" href="#current">Current</a><a class="link-line" href="#activity">Activity</a><a class="link-line" href="#work">Archive</a><a class="link-line" href="#about">About</a></nav>
      <a class="link-line top-github" href="https://github.com/SahilKDas" target="_blank" rel="noopener">GitHub ↗</a>
    </header>

    <main id="top">
      <section class="act-approach" data-approach data-scene="SC.01|THE APPROACH" aria-label="Sahil K. Das introduction">
        <div class="scene-sticky">
          <div class="portal-scene" aria-hidden="true">
            <Image class="scene-layer portal-sky" src={portalSky} alt="" widths={imageWidths} sizes="100vw" format="webp" quality={74} loading="eager" fetchpriority="high" />
            <Image class="scene-layer portal-landscape" src={portalLandscape} alt="" widths={imageWidths} sizes="100vw" format="webp" quality={76} loading="eager" />
            <div class="portal-ocean"><Image src={fieldSky} alt="" widths={imageWidths} sizes="60vw" format="webp" quality={68} loading="eager" /></div>
            <div class="world-effects"><div class="ambient-nebula"></div><div class="ambient-stars stars-a"></div><div class="ambient-stars stars-b"></div><div class="ambient-water"></div><div class="ambient-particles"></div></div>
            <Image class="scene-layer portal-architecture" src={portalArchitecture} alt="" widths={imageWidths} sizes="100vw" format="webp" quality={78} loading="eager" />
            <Image class="scene-layer portal-foreground" src={portalForeground} alt="" widths={imageWidths} sizes="100vw" format="webp" quality={78} loading="eager" />
            <div class="portal-radiance"></div><div class="scene-vignette"></div><div class="scene-veil"></div>
          </div>
          <div class="hero-copy">
            <p class="hero-kicker">Independent R&amp;D · systems · intelligence</p>
            <h1 aria-label="Sahil K. Das"><span class="mask-line"><span class="mask-word">SAHIL K.</span></span><span class="mask-line"><span class="mask-word outline">DAS</span></span></h1>
            <p class="hero-intro">I build engines, runtimes, neural systems, and ambitious experiments to answer one useful question: <strong>what if?</strong></p>
          </div>
          <a class="scroll-cue" href="#crossing"><span>Enter the systems</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9l7 7 7-7"></path></svg></a>
        </div>
      </section>

      <section id="crossing" class="act-crossing" data-crossing data-scene="SC.02|THE CROSSING" aria-hidden="true"><div class="crossing-sticky"><canvas data-hyperspace></canvas><div class="crossing-white"></div><p class="crossing-label">Below the abstraction</p></div></section>

      <section id="atlas" class="act-field" data-field data-scene="SC.03|THE SYSTEMS FIELD" aria-label="Systems atlas">
        <div class="field-sticky">
          <div class="field-stage" aria-hidden="true">
            <Image class="field-layer field-sky" src={fieldSky} alt="" widths={imageWidths} sizes="100vw" format="webp" quality={70} loading="lazy" />
            <Image class="field-layer field-mist" src={fieldMist} alt="" widths={imageWidths} sizes="100vw" format="webp" quality={68} loading="lazy" />
            <Image class="field-layer field-flora" src={fieldFlora} alt="" widths={imageWidths} sizes="100vw" format="webp" quality={70} loading="lazy" />
            <canvas class="field-spores" data-spores></canvas>
            <Image class="field-layer field-grass" src={fieldGrass} alt="" widths={imageWidths} sizes="100vw" format="webp" quality={72} loading="lazy" />
            <div class="field-scrim"></div>
          </div>
          <div class="field-content">
            <p class="chapter-lede">A living atlas of things I build, question, break, and rebuild.</p>
            <div class="atlas-title"><span>THE</span><strong>SYSTEMS</strong><span>FIELD</span></div>
            <nav class="atlas-index" aria-label="Atlas destinations">
              <a href="#current"><span>Current currents</span><small>Neural work and native reconstruction</small><i>01</i></a>
              <a href="#activity"><span>Public signals</span><small>Activity, organizations, and collaboration</small><i>02</i></a>
              <a href="#work"><span>Complete archive</span><small>Every substantive public repository</small><i>03</i></a>
              <a href="#about"><span>Next horizon</span><small>DeepMind, open work, and difficult problems</small><i>04</i></a>
            </nav>
          </div>
          <div class="field-veil" aria-hidden="true"></div>
        </div>
      </section>

      <div class="paper-world" data-paper>
        <section id="current" class="current-intro page-width">
          <p class="eyebrow" data-reveal>01 · CURRENT CURRENTS</p>
          <h2 data-reveal>THE WORK<br />IS ALIVE.</h2>
          <div class="current-copy" data-reveal><p>Sometimes I ship in a day; sometimes I disappear into a month-long build.</p><p>Every repository is a laboratory. The work below is what’s moving now.</p></div>
        </section>

        <section class="project-film" data-project-film data-scene="SC.04|THE CURRENT" aria-label="Selected current projects">
          <div class="project-stage">
            <div class="project-counter"><span data-project-number>01</span><i></i><span>{String(featured.length).padStart(2, '0')}</span></div>
            {featured.map((project, index) => project && (
              <article class="project-frame" data-project-frame data-index={index}>
                <div class="project-visual"><span class="project-orbit orbit-a"></span><span class="project-orbit orbit-b"></span><strong>{project.name.slice(0, 2).toUpperCase()}</strong><em>{project.language}</em></div>
                <div class="project-copy"><p>{project.category} · {project.archived ? 'Archived' : project.fork ? 'Active fork' : 'Active'}</p><h3 class={`mask-line ${project.name === 'KinokoDS' ? 'title-compact' : ''}`}><span class="mask-word">{project.name}</span></h3><div><p>{clean(project.description)}</p><a href={project.href} target="_blank" rel="noopener">Open repository ↗</a></div></div>
              </article>
            ))}
          </div>
        </section>

        <section class="horizons page-width">
          <p class="eyebrow" data-reveal>02 · LONG HORIZON</p>
          <div class="horizon-head" data-reveal><h2>FOUR SYSTEMS.<br />NO SMALL QUESTIONS.</h2><p>Priority work, long-term reconstruction, and an open engine ecosystem.</p></div>
          <div class="horizon-list">
            {horizons.map((project, index) => project && <a href={project.href} target="_blank" rel="noopener" data-reveal><span>{String(index + 1).padStart(2, '0')}</span><strong>{project.name}</strong><small>{project.language}</small><p>{clean(project.description)}</p><i>↗</i></a>)}
          </div>
        </section>

        <section id="activity" class="signals page-width">
          <div class="signals-head"><p class="eyebrow" data-reveal>03 · PUBLIC SIGNALS</p><h2 data-reveal>NOT A FEED.<br />A TRAIL.</h2><p data-reveal><i></i><span data-activity-source>Audited snapshot · Nov 8</span></p></div>
          <div class="signals-grid">
            <div class="activity-list" data-activity-list data-reveal>{fallbackActivity.map((item, index) => <a href={item.href} target="_blank" rel="noopener"><span>{String(index + 1).padStart(2, '0')}</span><small>{item.kind}</small><strong>{item.repo}</strong><em>{item.detail}</em><time datetime={item.timestamp}>{date(item.timestamp)}</time><i>↗</i></a>)}</div>
            <aside class="organizations" data-reveal><p>Organizations</p><a href="https://github.com/OpenShobu" target="_blank" rel="noopener"><strong>OpenShobu</strong><span>Sekigahara, cani, and the Universal Shobu Protocol.</span><i>↗</i></a><a href="https://github.com/ReseraProject" target="_blank" rel="noopener"><strong>ReseraProject</strong><span>Shared research and web experiments.</span><i>↗</i></a><p>Interests</p><div>{interests.map(interest => <span>{interest}</span>)}</div></aside>
          </div>
        </section>

        <section id="work" class="archive page-width">
          <div class="archive-head"><p class="eyebrow" data-reveal>04 · COMPLETE PUBLIC INDEX</p><h2 data-reveal>EVERYTHING<br />SUBSTANTIVE.</h2><p data-reveal>{repos.length} repositories across my account and organizations. Empty repositories and explicit future markers stay out of the way.</p></div>
          <div class="archive-tools" data-reveal><label><span>⌕</span><input type="search" aria-label="Search repositories" placeholder="Search names and descriptions" data-search /></label><div>{categories.map(category => <button type="button" class={category === 'All' ? 'active' : ''} data-filter={category}>{category}<span>{counts[category]}</span></button>)}</div></div>
          <div class="repo-index" data-repo-index>
            {repos.map((repo, index) => <details class="repo" data-repo data-name={`${repo.name} ${clean(repo.description)}`.toLowerCase()} data-category={repo.category}>
              <summary><span>{String(index + 1).padStart(2, '0')}</span><strong>{repo.name}</strong><small>{repo.category}</small><small>{repo.language}</small><em>{repo.archived ? 'Archived' : repo.fork ? 'Fork' : 'Active'}</em><i>+</i></summary>
              <div class="repo-detail"><p>{clean(repo.description)}</p><dl><div><dt>Owner</dt><dd>{repo.owner}</dd></div><div><dt>Last push</dt><dd>{date(repo.updatedAt)}</dd></div><div><dt>Size</dt><dd>{repo.sizeKb.toLocaleString()} KB</dd></div><div><dt>License</dt><dd>{repo.license}</dd></div></dl><div class="repo-topics">{repo.topics.length ? repo.topics.map(topic => <span>{topic}</span>) : <span>No published topics</span>}</div><a href={repo.href} target="_blank" rel="noopener">Open repository ↗</a></div>
            </details>)}
            <p class="no-results" data-no-results hidden>Nothing matches this view.</p>
          </div>
        </section>
      </div>

      <section id="about" class="act-abyss" data-abyss data-scene="SC.05|THE NEXT HORIZON" aria-label="About and contact">
        <div class="abyss-sticky">
          <div class="abyss-stage" aria-hidden="true"><Image class="abyss-deepfield" src={abyssDeepfield} alt="" widths={imageWidths} sizes="100vw" format="webp" quality={72} loading="lazy" /><Image class="abyss-disc" src={abyssDisc} alt="" widths={imageWidths} sizes="90vw" format="webp" quality={76} loading="lazy" /><div class="abyss-vignette"></div></div>
          <div class="about-copy"><p class="eyebrow">05 · THE NEXT HORIZON</p><h2><span>I WILL APPLY TO</span><strong>GOOGLE<br />DEEPMIND.</strong></h2><div><p>I’m zooming in on neural systems, search, learning environments, and work that proves I can operate below the abstraction.</p><p>Open to work, research, collaborators, and difficult technical problems.</p></div></div>
          <div class="contact-copy"><p>Have a hard problem?</p><h2 class="mask-line"><span class="mask-word">LET IT SURFACE.</span></h2><div><a href="https://github.com/SahilKDas" target="_blank" rel="noopener">GitHub ↗</a><a href="https://github.com/OpenShobu" target="_blank" rel="noopener">OpenShobu ↗</a><button type="button" data-copy>Discord · lordhank2</button></div></div>
        </div>
      </section>
    </main>

    <footer><span>© {new Date().getFullYear()} Sahil K. Das</span><span>Systems between worlds</span><a href="#top">Back to the approach ↑</a></footer>
    <script src="../scripts/cinema.ts"></script>
  </body>
</html>
